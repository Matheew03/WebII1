# Application Environment Configuration Example

# Base URL for Backend API
NG_APP_API_BASE_URL=https://api.example.com/v1

# Application Environment (development, staging, production)
NG_APP_ENV=development

# Feature Flags
NG_APP_ENABLE_ANALYTICS=false

# Authentication Config (Mock/Placeholder)
NG_APP_AUTH_DOMAIN=auth.example.com
NG_APP_CLIENT_ID=your_client_id_here
